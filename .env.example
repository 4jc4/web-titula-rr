# Onde o SERVIDOR do Next alcança a api-titula-rr (nunca o navegador — ver
# lib/env.ts). Dev: a API rodando solta em outra porta. Produção: nome do
# container na rede Docker interna (container_name: titula-rr-api).
API_INTERNAL_URL="http://localhost:3000"

# Mesma URL, mas para o `npm run codegen` (orval) buscar o OpenAPI JSON.
# Só entra em jogo quando você roda codegen manualmente; em CI é passada
# como env do próprio job.
ORVAL_API_URL="http://localhost:3000/api/docs-json"
